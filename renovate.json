{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>incognitojam/renovate-config",
    "github>incognitojam/renovate-config:automerge",
    "github>incognitojam/renovate-config:scoped"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "repos/**"
  ],
  "packageRules": [
    {
      "description": "Icon sets publish data-only releases every few days; collect them into one monthly PR",
      "matchPackageNames": [
        "@iconify-json/**"
      ],
      "groupName": "Iconify icon sets",
      "schedule": [
        "* 0-3 1 * *"
      ]
    },
    {
      "description": "Hold Solid 2 until stable @solidjs/vite-plugin 3 (vite-plugin-solid's successor) and @tanstack/solid-query 6 are available",
      "matchPackageNames": [
        "solid-js",
        "@solidjs/router",
        "@solidjs/testing-library",
        "vite-plugin-solid",
        "@tanstack/solid-query"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
