{
  "name": "timeline",
  "version": "0.17.3",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "setup": "./scripts/setup.sh",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "mcp": "bun run src/mcp.ts",
    "embeddings": "bun run src/embeddings/cli.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:status": "bun run scripts/dev-ctl.ts status",
    "dev:stop": "bun run scripts/dev-ctl.ts stop",
    "inbox": "bun run src/inbox/index.ts",
    "service": "bun run src/service.ts",
    "sync:once": "bun run src/sync/once-cli.ts",
    "service:verbose": "bun run src/service.ts --verbose",
    "build:service": "bun run scripts/build-service-artifact.ts",
    "smoke-service": "./scripts/smoke-service.sh",
    "media-inventory": "bun run src/scripts/media-inventory.ts",
    "media-upload": "bun run src/scripts/media-upload.ts",
    "media-evict": "bun run src/scripts/media-evict.ts",
    "media-recover-discord": "bun run src/platforms/discord/scripts/media-recover.ts",
    "media-recover-facebook": "bun run src/platforms/facebook/scripts/media-recover.ts",
    "lint": "bunx biome lint src/ web/src/ && oxlint src/ web/src/",
    "test": "bun test",
    "test:api": "bun test src/api/",
    "seed": "bun run src/seed/index.ts",
    "check-event-types": "bun run src/scripts/check-event-types.ts",
    "docs:sources": "bun run scripts/docs-sources.ts",
    "prepare-sample": "bun run scripts/prepare-sample-db.ts",
    "prepare-full": "bun run scripts/prepare-sample-db.ts --full",
    "changeset": "changeset",
    "release:version": "changeset version && bun run version:sync",
    "version:sync": "bun run scripts/sync-product-version.ts",
    "version:check": "bun run scripts/check-product-version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@changesets/cli": "^3.0.1",
    "@effect/tsgo": "^0.67.0",
    "@types/bun": "latest",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.22",
    "@effect/platform-bun": "^4.1.2",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.51",
    "date-fns": "^4.1.0",
    "effect": "^4.1.2",
    "hono": "^4.13.0",
    "jose": "^6.2.8",
    "js-tiktoken": "^1.0.21",
    "marked": "^18.0.9",
    "sharp": "^0.35.3",
    "sqlite-vec": "^0.1.9",
    "thumbhash": "^0.1.1",
    "zod": "^4.3.5"
  }
}
